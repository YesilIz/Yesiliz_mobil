# Gradle / Android
.gradle/
build/
*/build/
local.properties

# Eclipse/IDE'nin Gradle dışı çıktı dizini. Bir kez `core-risk/bin/` olarak
# kazara commit'lendi: kaynağın eski bir kopyası olduğu için hem kafa
# karıştırıyor hem de arama sonuçlarını ikiye katlıyordu.
bin/
*/bin/
.cxx/
*.apk
*.aab
*.iml

# Release imzalama anahtarı — ASLA depoya girmez.
# Kaybolursa uygulama bir daha güncellenemez; yedeği depo dışında tutulur.
*.jks
*.keystore

# Android Studio / IntelliJ
.idea/
captures/
.externalNativeBuild/
.kotlin/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Kök dizindeki gevşek referans dosyaları — proje kaynağı değil
/*.png
/recap.txt
/projeaciklamasi.md
/mcp.txt

# İmzalama anahtarı notları ve parolalar — depo özel olsa da girmez.
# "Yeşiliz uygulama parolası anahtarı.txt" doğrudan bir parola taşıyor;
# parmak izleri de anahtarla birlikte tek klasörde durduğu için klasör bütün olarak dışarıda.
debug aahtarları/

# Gerçek cihazdan alınan veri yedekleri (adb run-as tar).
# Kullanıcının ham kullanım verisi; §4 "ham veri cihazdan çıkmaz" ile aynı sınır.
yesiliz-cihaz-yedek/
