<?xml version="1.0" encoding="utf-8"?>
<!--
  Ağ güvenliği.

  Varsayılan olarak **şifresiz trafik kapalı** — üretimde HTTPS zorunlu.
  Tek istisna emülatörün makineye baktığı `10.0.2.2`: yerel geliştirme
  sunucusunun (backend/docker-compose.yml) TLS sertifikası yok ve bunun
  için sahte sertifika üretmek geliştirme akışına gereksiz yük.

  Bu istisna gerçek bir cihazda hiçbir şeye izin vermiyor: 10.0.2.2
  yalnızca Android emülatöründe anlamlı bir adres.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
