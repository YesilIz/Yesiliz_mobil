<?xml version="1.0" encoding="utf-8"?>
<!--
  Ağ güvenliği — release.

  Şifresiz trafik **kapalı**, istisnasız. Backend HTTPS ile yayında
  (`docs/dagitim.md`) ve release derlemesinin gömdüğü adres
  `BuildConfig.API_TABANI`; o adresin https:// olduğu derleme sırasında
  ayrıca doğrulanıyor (`app/build.gradle.kts`).

  Bir zamanlar `10.0.2.2` için cleartext istisnası vardı — emülatörün
  TLS'siz geliştirme sunucusuna ulaşabilmesi için. Yayınlanan APK'da
  hiçbir işe yaramıyordu (10.0.2.2 yalnızca emülatörde anlamlı) ama
  release yapılandırmasında şifresiz trafiğe açık bir kapı bırakıyordu;
  HTTPS gelince silindi.

  Debug derlemesi `src/debug/res/xml/ag_guvenligi.xml` ile bu dosyayı
  override ediyor: gerçek cihazda geliştirme sunucusuna LAN adresiyle
  bağlanabilmek gerekiyor (`debug.md` O-14).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
