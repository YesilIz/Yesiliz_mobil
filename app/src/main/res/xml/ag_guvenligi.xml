<!--
  Ağ güvenliği — release.

  Şifresiz trafik **tamamen kapalı**, istisnasız — üretimde HTTPS zorunlu
  (görev tanımı §6: "Release sürümü oluşturulurken 10.0.2.2 kullanılmamalı").
  `10.0.2.2` istisnası daha önce buradaydı; artık gerek yok çünkü release
  `BuildConfig.API_BASE_URL` her zaman gerçek HTTPS adresini taşıyor,
  emülatör adresine hiç başvurmuyor.

  Debug derlemesi `src/debug/res/xml/ag_guvenligi.xml` ile bu dosyayı
  override ediyor: gerçek cihazda geliştirme sunucusuna LAN adresiyle
  bağlanabilmek gerekiyor (`debug.md` O-14).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
