<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      İZİNLER — CLAUDE.md §4'e göre bilerek DAR tutuldu.
      YOK ve olmayacak: konum/GPS, rehber, arama geçmişi, mesaj/içerik erişimi.

      PACKAGE_USAGE_STATS normal bir izin değil; kullanıcı Ayarlar → Kullanım
      erişimi ekranından elle vermek zorunda. `tools:ignore` bu yüzden —
      lint "korumalı izin" diye uyarıyor ama kullanımı meşru.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Nudge overlay — kısa mola hatırlatıcısı için (CLAUDE.md §11 madde 1).
      SYSTEM_ALERT_WINDOW da PACKAGE_USAGE_STATS gibi normal izin değil;
      kullanıcı Ayarlar → "diğer uygulamaların üzerinde göster" ekranından
      elle vermek zorunda (`NudgeIzni`).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Aktif yürüyüş sayacı arka planda da çalışsın (debug.md İ-3).

      Eski karar (CLAUDE.md §12 K15) foreground service kullanmıyordu:
      ekran açık kaldığı sürece sayıyordu. Gerçek cihazda bu, özelliği tam
      da kullanılacağı anda çalışmaz kılıyor; yürüyüşe çıkan kullanıcı
      telefonu cebine koyuyor, ekran kapanıyor, sayaç duruyor. Ekranı 15
      dakika açık tutarak yürümek uygulamanın kendi mesajıyla da çelişiyor.

      FOREGROUND_SERVICE_HEALTH, egzersiz oturumunun doğru sınıfı ve
      Android 14+ tiplenmiş servis şartını karşılıyor. Servis yalnızca
      oturum sürerken yaşıyor, tamamlanınca kendini durduruyor.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
      Health Connect — SADECE adım ve egzersiz süresi.
      Kalp atışı, uyku, kilo, konum içeren egzersiz rotası İSTENMİYOR.
      Aktivite sönümlemesinin (%15 tavan) tek girdisi bu ikisi.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!--
      Arka planda okuma. Bu bildirim OLMADAN adım verisi pratikte hiç
      gelmiyordu: Health Connect, uygulama ön planda değilken okumayı
      reddediyor ve

        RemoteException: … must be in foreground to read the following
        data types [Steps, StepsCadenceSeries]

      atıyor. Adımı okuyan iki yerin ikisi de ön planda değil —
      `GunlukOzetWorker` gece koşuyor, `YuruyusServisi` ekran kapalıyken
      sayıyor (§12 K21). İstisna `SaglikOkuyucu` içinde yutuluyordu, yani
      izin verilmiş olsa bile `adim = 0`, `sporDk = 0`, `D = 1,0` kalıyordu.

      Ayrı bir izin: kullanıcı okuma izinlerini verip bunu vermeyebilir.
      O yüzden `gerekliIzinler`'e değil `istenenIzinler`'e giriyor —
      verilmezse uygulama çalışmaya devam ediyor, yalnızca gecelik özet
      adım göremiyor ve ekran bunu söylüyor.
    -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!--
      Faz 2 backend'i (backend/). Sunucuya YALNIZCA günlük özet ve skor
      gidiyor; ham kullanım olayları cihazda kalıyor (§4). Gönderim
      "Yeşilay ile paylaşım" onayına bağlı ve varsayılan kapalı.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Günlük hatırlatma (Profil › Bildirim saatleri). Varsayılan KAPALI ve
      izin yalnızca kullanıcı hatırlatmayı açtığında isteniyor — açılışta
      izin sormak, henüz istemediği bir şey için rahatsız etmek olurdu.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Paket görünürlüğü (Android 11+).

      QUERY_ALL_PACKAGES KULLANILMIYOR — Play Store gerekçe istiyor ve
      gereğinden geniş. Bunun yerine yalnızca **başlatıcıda görünen**
      uygulamalar sorgulanabiliyor; zaten ekran süresi üreten onlar.
      Bu görünürlük ApplicationInfo.category yedeği için gerekli.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
          Health Connect'in KENDİSİ ayrıca bildirilmek zorunda.

          Yukarıdaki MAIN/LAUNCHER sorgusu onu görmüyor: bazı cihazlarda
          (Samsung SM-A217F / Android 12) Health Connect'in başlatıcı
          aktivitesi yok, yalnızca SettingsActivity1 var. Paket görünmeyince
          getSdkStatus() SDK_AVAILABLE dönmüyor ve uygulama, kurulu olan
          Health Connect için "kurulu değil" deyip Play Store'a
          yönlendiriyordu; Play Store'da buton "Kaldır" yazarken.

          Sonuç: adım ve spor verisi hiç gelmiyor, D = 1,0 kalıyor, aktivite
          sönümlemesi gerçek cihazda hiç uygulanmıyordu (`debug.md` K-6).
          Health Connect istemcisi 1.2.0-alpha01 bu bildirimi kendiliğinden
          eklemiyor.
        -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".YesilizApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/uygulama_adi"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/ag_guvenligi"
        android:theme="@style/Theme.Yesiliz">

        <!--
          WorkManager'ın kendi kendine başlamasını KAPAT.

          `YesilizApp` `Configuration.Provider` uyguluyor ve worker fabrikası
          olarak Hilt'inkini veriyor. Bu sağlayıcı kaldırılmazsa WorkManager
          uygulama açılmadan varsayılan yapılandırmayla başlar, `@HiltWorker`
          ile işaretli worker'lar bağımlılıklarını alamaz ve çalışma anında
          "Could not instantiate worker" ile düşer.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          "Geçmişi indir" dosyalarının paylaşılması. Kapsam bilerek dar:
          yalnızca `cacheDir/disa_aktarim` (bkz. res/xml/dosya_yollari.xml).
          Veritabanı ve DataStore paylaşıma açık DEĞİL.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dosyalar"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/uygulama_adi"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Yesiliz"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Health Connect gerekçe ekranı — Android 13 ve altı.

              HC izin istemeden ÖNCE uygulamanın "bu veriyi niçin istiyorum"
              ekranını bildirmesini şart koşuyor. Bildirilmezse izin diyaloğu
              sessizce izinsiz dönüyor; hata da vermiyor. Emülatörde HC kurulu
              olmadığı için bu hiç görülmemişti.

              Cevabı `ui/ekran/saglik/` zaten veriyor, bu yüzden ayrı bir
              Activity yok: MainActivity eylemi okuyup Rota.SAGLIK_IZIN'e
              gidiyor (tek Activity kuralı, CLAUDE.md §5).
            -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          Aynı gerekçe ekranı — Android 14+ (targetSdk 37 ile geçerli olan yol).

          `START_VIEW_PERMISSION_USAGE` izni, bu takma adı yalnızca sistemin
          başlatabilmesi için: `exported="true"` olmak zorunda ama herhangi bir
          uygulamaya açık olmamalı.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Ana ekran widget'ları (docs/tasarim-referans.md §2 / 39, 40).

          `exported="true"` zorunlu: widget'ı yerleştiren ve güncelleyen
          launcher başka bir uygulama. `APPWIDGET_UPDATE` dışında bir eylem
          dinlenmiyor, yani dışarıdan tetiklenebilecek başka bir yüzey yok.
        -->
        <receiver
            android:name=".widget.EkranSuresiWidgetAlicisi"
            android:exported="true"
            android:label="@string/uygulama_adi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ekran_suresi_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.GununSorusuWidgetAlicisi"
            android:exported="true"
            android:label="@string/uygulama_adi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/gunun_sorusu_widget_info" />
        </receiver>

        <!--
          Nudge tetikleyicisi + overlay penceresi. `specialUse` — bu servis
          veri senkronize etmiyor, canlı davranışsal bir hatırlatıcı
          gösteriyor; mevcut FGS tiplerinden hiçbiri tam karşılamıyor.
        -->
        <service
            android:name=".nudge.NudgeOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Kısa mola hatırlatıcı göstermek için ekran kullanımını canlı izler" />
        </service>

        <!--
          Aktif yürüyüş sayacı (debug.md İ-3).

          `health` tipi egzersiz oturumunun doğru sınıfı. Servis yalnızca
          kullanıcı yürüyüşü başlattığında çalışıyor ve hedef süre dolunca
          kendini durduruyor; sürekli açık kalan bir servis değil.
        -->
        <service
            android:name=".arkaplan.YuruyusServisi"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>

</manifest>
