# Yeşilİz backend — örnek ortam dosyası. Kopyala: cp .env.example .env
# Gerçek değerler asla depoya girmez (.env zaten .gitignore'da).

# development / test / production. production'da aşağıdaki iki değer
# varsayılanla veya SQLite ile bırakılırsa uygulama başlamayı reddeder.
YESILIZ_ORTAM=development

# docker-compose bunu PostgreSQL URL'iyle eziyor; production'da PostgreSQL
# bağlantı adresi buraya yazılır.
YESILIZ_VERITABANI_URL=sqlite+pysqlite:///./yesiliz.db

# Production'da güçlü ve rastgele bir değerle DEĞİŞTİRİLMELİ:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
YESILIZ_JWT_ANAHTARI=gelistirme-anahtari-uretimde-degistir

# Virgülle ayrılmış origin listesi (CORS). Boş = hiçbir origin'e izin yok.
# Android istemcisi Origin göndermez; bu yalnızca tarayıcı tabanlı
# istemcileri (uzman/Yeşilay paneli, Faz 3) ilgilendirir.
YESILIZ_IZINLI_KAYNAKLAR=

YESILIZ_ERISIM_DAKIKA=30
YESILIZ_YENILEME_GUN=30
YESILIZ_ESLESTIRME_KODU_DAKIKA=10
