# Yeşilİz backend — ortam değişkenleri.
#
# Bu dosya ÖRNEKTİR ve depoda durur. Gerçek değerler `.env`'e yazılır
# (`.gitignore`'da) ya da sağlayıcının değişken paneline girilir.
# **Buraya gerçek secret yazmayın.**
#
# Ayrıntı: docs/dagitim.md

# development | test | production
# production seçildiğinde açılışta doğrulama çalışıyor: varsayılan JWT
# anahtarı, 32 karakterden kısa anahtar ve SQLite reddediliyor.
ENVIRONMENT=development

# Railway'de PostgreSQL eklendiği anda otomatik enjekte ediliyor — orada
# elle tanımlamayın. Yerelde docker-compose kendi değerini veriyor.
# `postgresql://` şeması psycopg3'e otomatik çevriliyor.
DATABASE_URL=postgresql://yesiliz:yesiliz@localhost:5433/yesiliz

# Üretimde ZORUNLU. Üretmek için:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Erişim jetonu ömrü. Kısa tutuluyor: telefon çalınırsa pencere dar olsun.
# Yenileme jetonu 30 gün (YESILIZ_YENILEME_GUN).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Virgülle ayrılmış kaynak listesi. Panel sunucu tarafında render edildiği
# için çapraz kaynak istek yapmıyor, mobil istemci de CORS'a tabi değil —
# yani pratikte boş kalıyor ve hiçbir tarayıcı kaynağına izin verilmiyor.
ALLOWED_ORIGINS=

# --- servis rolü (docs/panel-plani.md §4, CLAUDE.md §12 K57) ---
# `api` (varsayılan) cihaz uçlarını, `panel` yönetim + YEDAM panelini mount
# ediyor. Aynı imaj, iki Railway servisi. Bu dosya API servisini anlatıyor;
# panel servisinde SERVER_ROLE=panel yazılır ve aşağıdaki üçü ZORUNLU olur.
SERVER_ROLE=api

# Oturum çerezi ve CSRF jetonu bundan türetiliyor. ≥ 32 karakter.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_SECRET=

# Personel TOTP sırlarını şifreleyen Fernet anahtarı.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KAYBOLURSA bütün personel 2FA'yı yeniden kurmak zorunda kalır.
PANEL_TOTP_KEY=

# Panelin kendi HTTPS adresi — Origin denetimi ve TOTP kurulum bağlantısı.
PANEL_BASE_URL=

# Yalnızca yerel http geliştirmede false yapılır; üretimde açılış kapısı
# false'u reddediyor.
YESILIZ_PANEL_CEREZ_GUVENLI=true

# Aşağıdakiler nadiren değişiyor; varsayılanları `app/ayarlar.py`'de.
YESILIZ_YENILEME_GUN=30
YESILIZ_ESLESTIRME_KODU_DAKIKA=10
# Takvim tabanlı lig/ebeveyn penceresi. Anlık kayıtlar yine UTC tutulur.
YESILIZ_SAAT_DILIMI=Europe/Istanbul
